# Образ бота: Node (для Claude Code), Python, pandoc, WeasyPrint, шрифты.
# Код бота, скиллы и знания в образ не входят: они монтируются из git-checkout.
FROM node:22-bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    DISABLE_AUTOUPDATER=1 \
    LANG=C.UTF-8

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-venv python3-pip \
        git openssh-client ca-certificates tini \
        pandoc \
        fonts-noto-core fonts-noto-mono \
        libpango-1.0-0 libpangoft2-1.0-0 libharfbuzz-subset0 \
        libjpeg62-turbo libopenjp2-7 shared-mime-info \
    && rm -rf /var/lib/apt/lists/*

RUN npm install -g @anthropic-ai/claude-code && npm cache clean --force

# Супервизор берём из репозитория, чтобы он обновлялся вместе с кодом.
ENTRYPOINT ["/usr/bin/tini", "--", "bash", "/app/repo/deploy/entrypoint.sh"]
